# =============================================================================
# BC Deployment Analyzer — Environment Variables
# Copy to .env and fill in. setup/deploy.sh writes the Foundry section for you.
# =============================================================================

# --- Azure / Microsoft Foundry (written by setup/deploy.sh) -------------------
AZURE_SUBSCRIPTION_ID=
RESOURCE_GROUP=bc-deployment-analyzer-rg
FOUNDRY_RESOURCE_NAME=
PROJECT_NAME=bc-deployment-analyzer
FOUNDRY_ENDPOINT=
PROJECT_CONNECTION_STRING=
MODEL_DEPLOYMENT_NAME=gpt-5.4

# --- Application Insights & tracing (written by setup/deploy.sh) --------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPINSIGHTS_INSTRUMENTATION_KEY=
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# --- GitHub (dedicated bot account, fine-grained PAT) -------------------------
# Scopes: Contents: Read-only, Metadata: Read-only, Pull requests: Read-only
GITHUB_TOKEN=

# --- Business Central (Azure AD app in the partner tenant, client credentials) -
# Falls back to discovery/bc_config.json when unset.
BC_CLIENT_ID=
BC_CLIENT_SECRET=
# Default tenant/environment/company when a customer has no bc_environments[] entry
BC_TENANT_ID=
BC_ENVIRONMENT=Production
BC_COMPANY_NAME=
# Your AL publisher name — tags your own PTE apps in the BC extension list
BC_OWN_PUBLISHER=

# --- Optional: API key for the evaluation judge model ---------------------------
# Leave empty to use Entra ID (DefaultAzureCredential) instead.
AZURE_OPENAI_API_KEY=

# --- Optional: Foundry workflow agent name (orchestration/create_workflow_agent.py)
WORKFLOW_AGENT_NAME=bc-documentation-workflow
